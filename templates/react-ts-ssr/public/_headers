# Cloudflare Pages cache-control headers.
# Netlify honors _headers as a fallback if netlify.toml is missing.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Baseline security headers for every path. There's no Content-Security-Policy
# by default: a useful one must list your API, Sentry and embed origins (the
# demo embeds youtube-nocookie.com) and allow the inline theme boot script -
# add one per deployment and test it with Content-Security-Policy-Report-Only.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
