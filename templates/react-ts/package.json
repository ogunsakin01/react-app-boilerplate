{
  "name": "@react-app-boilerplate/template-react-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n app,storybook -c cyan,magenta \"vite\" \"storybook dev -p 6006 --no-open\"",
    "dev:app": "vite",
    "build": "tsc -b && vite build && node scripts/generate-sitemap.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "deploy": "node scripts/deploy.mjs",
    "generate": "node scripts/generate.mjs",
    "storybook": "storybook dev -p 6006",
    "strip-example": "node scripts/strip-example.mjs",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@sentry/react": "^10.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.85.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@clack/prompts": "^1.7.0",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.49.0",
    "@react-app-boilerplate/eslint-config": "workspace:*",
    "@react-app-boilerplate/playwright-config": "workspace:*",
    "@react-app-boilerplate/tsconfig": "workspace:*",
    "@react-app-boilerplate/vitest-config": "workspace:*",
    "@storybook/addon-a11y": "^9.0.0",
    "@storybook/react-vite": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query-devtools": "^5.62.0",
    "@tanstack/react-router-devtools": "^1.85.0",
    "@tanstack/router-plugin": "^1.85.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "concurrently": "^10.0.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "msw": "^2.6.6",
    "picocolors": "^1.1.1",
    "prettier": "^3.4.2",
    "storybook": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0",
    "workbox-window": "^7.4.1"
  },
  "resolutions": {
    "vite": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
