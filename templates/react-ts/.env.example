VITE_APP_TITLE="Atomic React"

# Sentry (opt-in — leave empty to disable Sentry entirely)
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT=""
VITE_SENTRY_TRACES_SAMPLE_RATE="0.1"

# Base URL for hashed assets (set at build time when serving via CDN subpath)
# VITE_BASE_URL="https://cdn.example.com/app/"

# Deploy target (used by `pnpm deploy` — see .claude/skills/configure-deploy)
# DEPLOY_BUCKET=""
# DEPLOY_ENDPOINT=""       # for R2 / DigitalOcean Spaces / MinIO
# DEPLOY_CLOUDFRONT_ID=""  # optional CloudFront distribution to invalidate
