{
  "name": "react-app-boilerplate",
  "version": "0.0.0",
  "private": true,
  "description": "Opinionated React + TypeScript + Vite boilerplate with TanStack Router, TanStack Query, Tailwind v4, MSW, Storybook, Playwright, jest-axe accessibility tests, atomic-design components, ESLint 9, husky, Renovate, and Changesets. Scaffold with `npm create atomic-react`.",
  "license": "MIT",
  "author": "Damilola Ogunsakin",
  "homepage": "https://github.com/ogunsakin01/react-app-boilerplate#readme",
  "bugs": {
    "url": "https://github.com/ogunsakin01/react-app-boilerplate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogunsakin01/react-app-boilerplate.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "eslint . && pnpm -r --if-present lint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "build": "pnpm -r --if-present build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
